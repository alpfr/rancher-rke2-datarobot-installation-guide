aws_region            = "us-east-1"
project               = "rke2-rancher-lab"
rancher_hostname      = "rancher.example.com" # Replace with real DNS in your public Route 53 hosted zone
route53_zone_id       = "Z0000000000000"      # Replace with actual public hosted zone ID
rke2_version          = "v1.36.5+rke2r1"
server_instance_type  = "m6i.xlarge"
agent_instance_type   = "m6i.large"
root_volume_gb        = 80
